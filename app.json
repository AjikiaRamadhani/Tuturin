{
  "expo": {
    "name": "Tuturin",
    "slug": "tuturin",
    "version": "1.0.0",
    "scheme": "tuturin",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.nullpointer.tuturin",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Tuturin memakai mikrofon agar kamu bisa berlatih berbicara.",
          "speechRecognitionPermission": "Tuturin memakai pengenalan suara untuk memeriksa ucapanmu."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF3F0",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      "expo-router",
      "expo-status-bar",
      "expo-font"
    ]
  }
}
